{
  "name": "crypto-ecom-template",
  "version": "1.0.0",
  "private": true,
  "description": "Production-ready, zero-secret, self-custodial crypto e-commerce template with Next.js 16, Prisma, and serverless payment watcher.",
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "next lint",
    "setup": "bun scripts/setup-wizard.ts || tsx scripts/setup-wizard.ts",
    "db:push": "prisma db push",
    "db:seed": "bun scripts/seed.ts || tsx scripts/seed.ts",
    "db:generate": "prisma generate",
    "test": "vitest run"
  },
  "dependencies": {
