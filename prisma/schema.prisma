// Prisma schema for Crypto E-Commerce Template
// Local dev default: SQLite (DATABASE_URL="file:./dev.db")
// Production: PostgreSQL / Neon (DATABASE_URL="postgres://...")

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ============ USERS & AUTH ============

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  username      String    @unique
  passwordHash  String
  name          String?
  role          String    @default("USER") // USER | ADMIN | RESELLER | AFFILIATE
  isReseller    Boolean   @default(false)
  isAffiliate   Boolean   @default(false)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  orders          Order[]
  addresses       Address[]
  cart            Cart?
  resellerProfile ResellerProfile?
  affiliateProfile AffiliateProfile?

  @@index([email])
  @@index([username])
  @@index([role])
}

// ============ PRODUCTS & VARIANTS ============

model Product {
  id              String           @id @default(cuid())
  slug            String           @unique
  name            String
  category        String           // e.g. merchandise, hardware, digital, custom
  categoryLabel   String
  description     String?
  longDescription String?          // Markdown supported
  featured        Boolean          @default(false)
  imageUrl        String?          // Main product image (R2/S3/external)
  customSchema    String?          // JSON array of custom input field specs
  isDigital       Boolean          @default(false)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  variants        ProductVariant[]

  @@index([category])
  @@index([featured])
  @@index([slug])
}

model ProductVariant {
  id           String      @id @default(cuid())
  productId    String
  displayName  String      // e.g. "Size Large / Black"
  sku          String      @unique
  price        Float       // Base price in USD
  inStock      Boolean     @default(true)
  stockQty     Int         @default(100)
  imageUrl     String?     // Variant-specific image
  sortOrder    Int         @default(0)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  product      Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  cartItems    CartItem[]
  orderItems   OrderItem[]

  @@index([productId])
  @@index([sku])
  @@index([inStock])
}

// ============ CART ============

model Cart {
  id        String     @id @default(cuid())
  userId    String     @unique
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     CartItem[]
}

model CartItem {
  id           String         @id @default(cuid())
  cartId       String
  variantId    String
  quantity     Int            @default(1)
  customValues String?        // JSON of custom user input values / uploaded asset URLs
  createdAt    DateTime       @default(now())

  cart         Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)
  variant      ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@index([cartId])
  @@index([variantId])
}

// ============ ORDERS & FULFILLMENT ============

model Order {
  id               String         @id @default(cuid())
  orderNumber      String         @unique // Human-readable e.g. ORD-9X28F
  trackingCode     String         @unique // Cryptographic public tracking lookup code
  userId           String?
  guestEmail       String?        // For guest checkout
  guestContact     String?        // Telegram / Signal / Email
  status           String         @default("PENDING") // PENDING | PAID | PROCESSING | SHIPPED | DELIVERED | CANCELLED | REFUNDED
  paymentStatus    String         @default("UNPAID") // UNPAID | PENDING | PAID | UNDERPAID | REFUNDED
  paymentMethod    String?        // e.g. "crypto:btc", "crypto:sol", "crypto:usdc_ethereum"
  paymentIntentId  String?
  cryptoAsset      String?
  cryptoTxHash     String?
  paymentExpiresAt DateTime?

  // Financial snapshot (USD)
  subtotal         Float
  discountAmount   Float          @default(0)
  shippingFee      Float          @default(0)
  handlingFee      Float          @default(0)
  total            Float
  currency         String         @default("USD")
  couponCode       String?

  // Shipping & Contact Address snapshot
  shippingAddress  String?        // JSON formatted address
  shippingMethod   String?        // "standard" | "express" | "digital"

  // Fulfillment & Notes
  trackingNumber   String?        // Carrier tracking number
  carrier          String?        // Carrier name (USPS, FedEx, DHL, etc.)
  customerNotes    String?
  adminNotes       String?

  // Reseller & Affiliate Attribution
  resellerSlug     String?
  affiliateCode    String?

  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  user             User?          @relation(fields: [userId], references: [id], onDelete: SetNull)
  items            OrderItem[]
  paymentIntent    PaymentIntent?

  @@index([userId])
  @@index([trackingCode])
  @@index([orderNumber])
  @@index([status])
  @@index([paymentStatus])
  @@index([createdAt])
  @@index([resellerSlug])
  @@index([affiliateCode])
}

model OrderItem {
  id           String          @id @default(cuid())
  orderId      String
  variantId    String?
  productName  String          // Snapshot
  variantName  String          // Snapshot
  sku          String          // Snapshot
  unitPrice    Float           // Snapshot
  quantity     Int
  customValues String?         // JSON snapshot of custom fields/uploads
  createdAt    DateTime        @default(now())

  order        Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variant      ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([variantId])
}

model Address {
  id        String   @id @default(cuid())
  userId    String
  fullName  String
  line1     String
  line2     String?
  city      String
  state     String
  zip       String
  country   String   @default("US")
  phone     String?
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ============ CRYPTO PAYMENT GATEWAY (BIP84 / XPUB DERIVATION) ============

model PaymentIntent {
  id              String    @id @default(cuid())
  orderId         String    @unique
  userId          String?
  asset           String    // btc | ltc | sol | usdc_ethereum | usdc_base | usdc_polygon | usdc_solana
  depositAddress  String    // Unique derived address from merchant zpub/xpub for this order
  addressIndex    Int?      // Child derivation index (m/0/index)
  expectedAmount  String    // Exact human-readable decimal amount e.g. "0.00052632"
  expectedAtomic  String    // Exact atomic units (Satoshis/Wei/Lamports)
  baseTotalUsd    Float
  exchangeRate    Float?
  status          String    @default("PENDING") // PENDING | DETECTED | CONFIRMED | EXPIRED | CANCELLED
  txHash          String?
  confirmations   Int       @default(0)
  expiresAt       DateTime
  createdAt       DateTime  @default(now())
  confirmedAt     DateTime?
  cancelledAt     DateTime?

  order           Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([asset])
  @@index([depositAddress])
  @@index([expiresAt])
}

model PaymentSettings {
  id                     String   @id @default("site") // Singleton
  paymentGateways        String   // JSON Record<AssetId, {enabled: boolean, xpub: string, address: string, nextIndex: number, minConfirmations: number}>
  paymentIntentTtlHours  Int      @default(48)
  updatedAt              DateTime @updatedAt
}

// ============ COUPONS & PROMOTIONS ============

model Coupon {
  id            String    @id @default(cuid())
  code          String    @unique
  discountType  String    // PERCENT | FIXED
  value         Float     // Percentage (1-100) or Fixed USD amount
  minOrder      Float     @default(0)
  maxUses       Int?      // null = unlimited
  usedCount     Int       @default(0)
  isActive      Boolean   @default(true)
  startsAt      DateTime?
  expiresAt     DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([code])
  @@index([isActive])
}

// ============ RESELLERS & AFFILIATES ============

model ResellerProfile {
  id              String    @id @default(cuid())
  userId          String    @unique
  slug            String    @unique // e.g. "apex-store" -> /r/apex-store
  businessName    String
  brandingJson    String?   // JSON { logoUrl, accentColor, heroTitle }
  discountTier    Float     @default(15.0) // Wholesale discount % off list price
  isActive        Boolean   @default(true)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([slug])
  @@index([isActive])
}

model AffiliateProfile {
  id              String    @id @default(cuid())
  userId          String    @unique
  code            String    @unique // e.g. "VIP2026" -> ?ref=VIP2026
  commissionRate  Float     @default(10.0) // Commission percentage
  payoutAddress   String?   // Crypto payout address
  payoutAsset     String?   // btc, sol, usdc_base, etc.
  totalEarned     Float     @default(0.0)
  totalPaid       Float     @default(0.0)
  pendingBalance  Float     @default(0.0)
  isActive        Boolean   @default(true)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  payoutRequests  PayoutRequest[]

  @@index([code])
  @@index([isActive])
}

model PayoutRequest {
  id                 String           @id @default(cuid())
  affiliateProfileId String
  amount             Float
  asset              String
  address            String
  status             String           @default("PENDING") // PENDING | APPROVED | PAID | REJECTED
  txHash             String?
  notes              String?
  createdAt          DateTime         @default(now())
  processedAt        DateTime?

  affiliateProfile   AffiliateProfile @relation(fields: [affiliateProfileId], references: [id], onDelete: Cascade)

  @@index([affiliateProfileId])
  @@index([status])
}

// ============ LOGS & AUDIT ============

model ActivityLog {
  id          String   @id @default(cuid())
  type        String   // "order", "payment", "auth", "admin", "system"
  action      String   // e.g. "order_created", "payment_detected", "login_failed"
  actorId     String?
  actorEmail  String?
  targetId    String?
  detailsJson String?  // JSON metadata
  status      String   @default("SUCCESS") // SUCCESS | FAILED | WARN
  createdAt   DateTime @default(now())

  @@index([type])
  @@index([action])
  @@index([createdAt])
}

model EmailLog {
  id        String   @id @default(cuid())
  to        String
  subject   String
  type      String   // "order_confirmation", "payment_received", "shipping_update"
  orderId   String?
  sentAt    DateTime @default(now())

  @@index([orderId])
  @@index([to])
}
