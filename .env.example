# ==============================================================================
# CRYPTO E-COMMERCE TEMPLATE — ZERO-SECRET CONFIGURATION TEMPLATE
# Copy this file to .env or .env.local and populate with your own values.
# NEVER commit .env or secrets to git!
# ==============================================================================

# Database Connection (SQLite default for dev, PostgreSQL / Neon for production)
DATABASE_URL="file:./dev.db"

# Public Branding & Metadata
NEXT_PUBLIC_SITE_NAME="Crypto Store"
NEXT_PUBLIC_SITE_DESCRIPTION="Private, Non-Custodial Crypto E-Commerce"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Core Security Secrets (Generate using: openssl rand -base64 32 or run 'npm run setup')
AUTH_SECRET="REPLACE_WITH_RANDOM_SECRET_BASE64_32"
PAY_TOKEN_SECRET="REPLACE_WITH_RANDOM_SECRET_HEX_32"
CRON_SECRET="REPLACE_WITH_RANDOM_SECRET_STRING"

# Feature Flags (true | false)
ENABLE_RESELLER="true"
ENABLE_AFFILIATES="true"
ENABLE_MARKETING="true"
ALLOW_GUEST_CHECKOUT="true"

# Cryptocurrency Payment Gateway
# Note: Deposit addresses are also configurable live via the Admin Dashboard (/admin/payments)
CRYPTO_PAYMENTS_ENABLED="true"

# External Blockchain RPCs & Explorer APIs (Optional, with public rate limits)
# COINGECKO_API_KEY=""
# ETHERSCAN_API_KEY=""
# SOLANA_RPC_URL=""
# HELIUS_API_KEY=""

# Cloudflare R2 / S3 Storage (Optional: required for custom upload fields and digital downloads)
# R2_ACCOUNT_ID=""
# R2_ACCESS_KEY_ID=""
# R2_SECRET_ACCESS_KEY=""
# R2_BUCKET_NAME=""
# R2_PUBLIC_DOMAIN=""

# Transactional Email (Resend — Optional)
# RESEND_API_KEY=""
# RESEND_FROM="no-reply@yourdomain.com"
